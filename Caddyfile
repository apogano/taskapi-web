{
	admin off
	auto_https off
	servers {
		# Cloud Run's internal proxy connects from a link-local address and
		# appends the client IP to X-Forwarded-For. Trust only that hop, and
		# read the header right to left so client-supplied entries are ignored.
		trusted_proxies static 169.254.0.0/16
		trusted_proxies_strict
	}
}

:{$PORT:8080} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy {$API_URL} {
			# Cloud Run routes requests by Host header
			header_up Host {upstream_hostport}
			# Hand the real client IP to the backend, proven by the shared secret
			header_up X-Client-IP {client_ip}
			header_up X-Proxy-Secret {$PROXY_SHARED_SECRET}
		}
	}

	handle {
		root * /srv
		# Vite fingerprints asset filenames, so they can be cached forever...
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# ...while index.html must always be revalidated to pick up new deploys
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}